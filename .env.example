# Role dona do schema — só usada pelo Alembic (migrations). Nunca é passada ao
# container da API.
POSTGRES_USER=chat_owner
POSTGRES_PASSWORD=troque-esta-senha-owner
POSTGRES_DB=chat_seguro
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Role de privilégio mínimo — usada pela API em runtime (sem permissão de
# criar/alterar tabelas).
APP_DB_USER=app_user
APP_DB_PASSWORD=troque-esta-senha-app

# JWT — sessão curta de propósito; o WebSocket do chat desconecta sozinho quando o
# token expira (não é só bloquear novas requisições). Para testar isso rapidamente,
# troque temporariamente para 1.
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-grande
JWT_EXPIRE_MINUTES=15

# Só usadas por `docker compose run --rm seed-admin` (cria o primeiro administrador).
# ADMIN_PASSWORD precisa ter 8+ caracteres, 1 maiúscula e 1 número.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# (não use domínios .test/.invalid/.localhost — são TLDs reservados que o
# email-validator recusa mesmo sem checar DNS)
ADMIN_PASSWORD=TroqueEstaSenha1
